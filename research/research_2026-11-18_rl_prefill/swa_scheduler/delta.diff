+    def _prepare_swa_verify_scheduler(self, metadata, forward_batch):
+        """Capture one native local-window plan before the first attention layer."""
+        metadata.swa_verify_scheduler = None
+        if not self._swa_verify_enabled or not forward_batch.forward_mode.is_target_verify():
+            return
+        spec = forward_batch.spec_info
+        b, width = forward_batch.batch_size, metadata.max_seq_len_q
+        table = metadata.swa_page_table if self.use_sliding_window_kv_pool else metadata.page_table
+        lens, cu = metadata.cache_seqlens_int32, metadata.cu_seqlens_q
+        if (spec is None or getattr(spec, "ragged_verify_layout", None) is not None
+                or getattr(spec, "custom_mask", None) is not None
+                or getattr(spec, "num_tokens_per_req", -1) != width
+                or width != self.speculative_num_draft_tokens or width < 2
+                or forward_batch.positions is None or forward_batch.positions.numel() != b * width
+                or forward_batch.encoder_lens is not None or metadata.image_token_ranges is not None
+                or metadata.swa_spec_metadata is not None or table is None or lens is None or cu is None
+                or table.ndim != 2 or table.shape[0] != b
+                or lens.shape != (b,) or cu.shape != (b + 1,)
+                or lens.dtype != torch.int32 or cu.dtype != torch.int32
+                or not lens.is_contiguous() or not cu.is_contiguous()):
+            return
+        max_k = table.shape[1] * self.page_size
+        if self.sliding_window_size >= max_k - 1:
+            # FA3 converts a window covering the entire table to full causal.
+            return
+        window = (self.sliding_window_size, 0)
+        plan = self._get_scheduler_metadata(
+            batch_size=b, max_seqlen_q=width, max_seqlen_k=max_k,
+            num_heads=self.num_attention_heads, num_heads_k=self.num_kv_heads,
+            headdim=self.head_dim, headdim_v=self.head_dim, qkv_dtype=self.kv_cache_dtype,
+            cache_seqlens=lens, cu_seqlens_q=cu, cu_seqlens_k_new=None,
+            max_seqlen_k_new=0, page_size=self.page_size, causal=True,
+            window_size=window, has_softcap=self.has_softcap,
+            num_splits=self.num_splits, pack_gqa=None, sm_margin=0,
+        )
+        # Native allocation (including the semaphore, if required) belongs to
+        # this eager call or recording. Replays execute the recorded preparation.
+        metadata.swa_verify_scheduler = (
+            plan, table, lens, cu, metadata.cu_seqlens_k, b, width, window, self.num_splits,
+        )
+
+    def _swa_verify_scheduler_for_layer(
+        self, metadata, forward_batch, layer, q, key_cache, value_cache, page_table,
