+"""Small host-only cuBLASLt bridge, cached outside the installed source tree."""
+import fcntl,hashlib,json,os,subprocess
+from pathlib import Path
+import torch
+
+def native_library_path():
+ source=Path(__file__).resolve().parent/'runtime_lt.cc'
+ key=hashlib.sha256(source.read_bytes()+str(torch.version.cuda).encode()).hexdigest()[:20]
+ base=Path(os.environ.get('SGLANG_JIT_CACHE_DIR',os.environ.get('SGLANG_CACHE_DIR',str(Path.home()/'.cache/sglang'))))
+ return base/'dflash_output_n'/key/'runtime_lt.so'
+
+def build_native():
+ source=Path(__file__).resolve().parent/'runtime_lt.cc'
+ roots=[Path(os.environ.get('CUDA_HOME','/usr/local/cuda')),
+        Path(torch.__file__).resolve().parent.parent/'nvidia/cu13',Path('/usr/local/cuda')]
+ root=next((p for p in roots if (p/'include/cublasLt.h').is_file()),None)
+ if root is None:raise RuntimeError('matching CUDA SDK headers unavailable')
+ libraries=[p for d in ('lib','lib64') for p in (root/d).glob('libcublasLt.so*') if p.is_file()]
+ library=next((p for p in libraries if p.name=='libcublasLt.so'),libraries[0] if libraries else None)
+ if library is None:raise RuntimeError('CUDA SDK cuBLASLt link library unavailable')
+ libdir=library.parent;compiler=os.environ.get('CXX','g++')
+ output=native_library_path();output.parent.mkdir(parents=True,exist_ok=True);stamp=output.with_suffix('.json')
+ identity=dict(source=hashlib.sha256(source.read_bytes()).hexdigest(),cuda=str(root),
+               header=hashlib.sha256((root/'include/cublasLt.h').read_bytes()).hexdigest(),compiler=compiler)
+ with output.with_suffix('.lock').open('a+') as guard:
+  fcntl.flock(guard,fcntl.LOCK_EX)
+  if output.exists() and stamp.exists() and json.loads(stamp.read_text()).get('identity')==identity:return
+  temporary=output.with_name(f'runtime_lt.{os.getpid()}.so')
+  command=[compiler,'-shared','-fPIC','-O2','-std=c++17',str(source),'-I'+str(root/'include'),
+           '-Wl,-rpath,'+str(libdir),str(library),'-o',str(temporary)]
+  result=subprocess.run(command,capture_output=True,text=True,timeout=60)
+  if result.returncode:raise RuntimeError('native build failed: '+result.stderr[-4000:])
+  os.replace(temporary,output)
+  stamp.write_text(json.dumps(dict(identity=identity,command=command,stderr=result.stderr),indent=2))
