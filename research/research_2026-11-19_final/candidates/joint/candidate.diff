+"""Explicit startup entry for the diagnostic output-N candidate; never auto-enables."""
+import json,statistics
+from sglang.srt.speculative.dflash_projection_gate import latency_gate
+import torch
+import torch.distributed as dist
+from .adapter import OutputNRouter
+from .runtime_projection import native_workspace
+from .native_build import build_native
+
+def _startup_timing(router,x,rounds=12):
+ """Measure native FC versus own FC plus real group gather, on every rank."""
+ entry=router.entries.get(tuple(x.shape))
+ if entry is None:return {'active':False}
+ records={'native_us':[],'control_us':[],'local_us':[],'gather_us':[],'combined_us':[]};bad=0;fallbacks=0
+ reference=router.original(x)
+ for _ in range(2):router(x)
+ torch.cuda.synchronize()
+ orders=(('native','candidate','control'),('control','candidate','native'),
+         ('candidate','native','control'),('control','native','candidate'),
+         ('native','control','candidate'),('candidate','control','native'))
+ for step in range(rounds):
+  for arm in orders[step%len(orders)]:
+   events=[torch.cuda.Event(enable_timing=True) for _ in range(3)]
+   events[0].record()
+   if arm in ('native','control'):out=router.original(x);events[2].record()
+   else:
+    local=router._local(entry,x)
+    if local is None:
+     native=router.original(x);width=native.shape[1]//router.group.world_size
+     local=native[:,router.group.rank_in_group*width:(router.group.rank_in_group+1)*width].contiguous();fallbacks+=1
+    events[1].record();out=router.group.all_gather(local,dim=-1);events[2].record()
+   events[2].synchronize()
+   if arm in ('native','control'):records[arm+'_us'].append(events[0].elapsed_time(events[2])*1000)
+   else:
+    records['local_us'].append(events[0].elapsed_time(events[1])*1000)
+    records['gather_us'].append(events[1].elapsed_time(events[2])*1000)
+    records['combined_us'].append(events[0].elapsed_time(events[2])*1000)
+   bad+=int(not torch.equal(out.view(torch.int16),reference.view(torch.int16)))
+   del out
+ return dict(active=not fallbacks,correct=not bad,mismatches=bad,fallbacks=fallbacks,scope='Synthetic startup inputs and real loaded weights; actual TP gather, not serving throughput',
+             medians={k:statistics.median(v) for k,v in records.items()},samples=records)
+
+@torch.no_grad()
+def create_projection(original,group,*,mode='shadow',rows=(),measure=True,calibration_budget_bytes=128*2**20):
+ """Call collectively after weight loading, before graph capture and serving.
+
+ Return None coherently if prerequisites fail. Only declared rows are enabled;
+ all other shapes keep the original projection. Rows are not workload IDs.
+ """
+ local={'error':None,'mode':mode,'rows':list(rows),'measure':bool(measure),'calibration_budget_bytes':calibration_budget_bytes}
+ try:
+  if not isinstance(original,torch.nn.Linear) or original.bias is not None:raise TypeError('native bias-free Linear required')
+  if original.weight.dtype!=torch.bfloat16 or not original.weight.is_cuda:raise TypeError('CUDA BF16 weight required')
+  if original.weight.ndim!=2 or group.world_size!=8:raise ValueError('requires a TP8 matrix projection')
+  n,k=original.weight.shape
+  if min(n,k)<=0 or n%8 or not original.weight.is_contiguous():raise ValueError('unsupported weight layout')
+  if torch.cuda.is_current_stream_capturing():raise ValueError('startup factory cannot run during capture')
+  if any(not isinstance(m,int) or m<=0 for m in rows):raise ValueError('invalid decode rows')
+  build_native()
+  workspace=native_workspace()
+  if workspace is None:raise ValueError('native workspace unavailable')
+  local['geometry']=[n,k];local['workspace']=workspace
+ except Exception as exc:local['error']=repr(exc)
+ declarations=[None]*group.world_size
+ dist.all_gather_object(declarations,local,group=group.cpu_group)
+ if any(d!=declarations[0] or d['error'] is not None for d in declarations):
+  if group.rank_in_group==0:print('DFLASH_OUTPUT_N_DISABLED '+json.dumps(declarations),flush=True)
+  return None
+ # Account for two BF16 inputs, two native references, one full diagnostic
+ # output, a local output, calibration scratch and the retained stream scratch.
+ bytes_per_row=4*k+6*n+2*(n//group.world_size)
+ allocation_bound=lambda m:2*workspace[1]+m*bytes_per_row
+ unsupported=[m for m in rows if allocation_bound(m)>calibration_budget_bytes]
+ rows=sorted(set(m for m in rows if allocation_bound(m)<=calibration_budget_bytes))
+ if not rows:
+  if group.rank_in_group==0:print('DFLASH_OUTPUT_N_DISABLED no configured rows within calibration budget',flush=True)
+  return None
+ router=OutputNRouter(original,group,mode=mode)
+ accepted,_=router.prepare_registration([(m,k) for m in rows])
+ if not accepted:return None
+ generator=torch.Generator(device=original.weight.device).manual_seed(20261119)
+ logs=[]
+ for m in rows:
+  # One shape at a time, bounded by the declared calibration allocation budget.
+  examples=[]
+  try:
+   x=torch.randn((m,k),device=original.weight.device,dtype=torch.bfloat16,generator=generator)
+   y=torch.randn(x.shape,device=x.device,dtype=x.dtype,generator=generator);y[:,::4]*=32;y[:,1::4]*=.03125
+   examples=[x,y]
+  except torch.cuda.OutOfMemoryError:pass
+  metadata=router.register(examples);row=dict(m=m,qualification=metadata)
+  timing=None;error=None
+  if measure and metadata.get('globally_enabled'):
+   # Recoverable dispatch rejection still gathers a native slice inside the
+   # timing function. A poisoned CUDA context is fatal, not caught here.
+   timing=_startup_timing(router,x)
+   if not timing.get('active') or not timing.get('correct'):error='startup exactness or dispatch failed'
+  reports=[None]*group.world_size
+  dist.all_gather_object(reports,dict(timing=timing,error=error),group=group.cpu_group)
+  for r in reports:
+   if r['timing'] is not None:r['timing']['admission']=latency_gate(r['timing'].get('samples',{}))
+  faster=not measure or (metadata.get('globally_enabled') and all(r['timing'] is not None and r['timing'].get('active') and r['timing'].get('correct') and r['timing']['admission']['accepted'] for r in reports))
+  if any(r['error'] is not None for r in reports) or not faster:
+   entry=router.entries.get((m,k))
+   if entry is not None:entry.plan.close()
+   router.entries[(m,k)]=None
+   row['disabled_after_startup']=True
+   row['disable_reason']='exactness/dispatch or all-rank combined latency gate'
+  row['ranks']=reports;logs.append(row)
+  examples.clear()
+  if 'x' in locals():del x
+  if 'y' in locals():del y
+ if group.rank_in_group==0:
+  print('DFLASH_OUTPUT_N_STARTUP '+json.dumps(dict(mode=mode,rows=logs,unsupported_rows=unsupported,calibration_budget_bytes=calibration_budget_bytes,
+   lifecycle='Static checkpoint and math policy only. Weight reload or policy changes require destroying dependent graphs and rebuilding the router.',
+   scratch_bytes=sum(t.numel() for t in router.stream_workspaces.values()))),flush=True)
+ return router
