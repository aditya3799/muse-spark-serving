@@ -0,0 +1,18 @@
+"""Fail-stop policy for a dispatched draft-projection cuBLASLt call.
+
+Only a documented unsupported configuration is an ordinary plan rejection.
+CUDA execution, library, allocation and unknown statuses must remain visible.
+This does not detect asynchronous failures; native stream synchronization does.
+"""
+class ProjectionVendorError(RuntimeError):
+    def __init__(self, status, operation):
+        self.status = int(status)
+        self.operation = operation
+        super().__init__(f"{operation} returned cuBLAS status {self.status}; worker abort required")
+
+
+def checked_vendor_status(status, operation):
+    status = int(status)
+    if status not in (0, 15):  # SUCCESS, NOT_SUPPORTED
+        raise ProjectionVendorError(status, operation)
+    return status
