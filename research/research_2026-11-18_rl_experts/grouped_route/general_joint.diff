+    inv_ptr,
+    scale_ptr,
+    HAS_SCALE: tl.constexpr,
+    TOPK: tl.constexpr,
+    H: tl.constexpr,
+    eps,
+    HAS_WEIGHT: tl.constexpr,
+    WEIGHT_FIRST: tl.constexpr,
+    BLOCK_H: tl.constexpr,
