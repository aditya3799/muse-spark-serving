+            or local_ids.dtype not in (torch.int32,torch.int64)
+            or not x.is_cuda or x.device != local_ids.device
+            or not x.is_contiguous() or not local_ids.is_contiguous()
+            or local_ids.shape[0] != x.shape[0]):
