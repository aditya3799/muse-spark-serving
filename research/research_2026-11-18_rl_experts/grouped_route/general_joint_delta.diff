diff --git a/python/sglang/kernels/jit/csrc/elementwise/route_activation.cuh b/python/sglang/kernels/jit/csrc/elementwise/route_activation.cuh
new file mode 100644
index 0000000..69ddce5
--- /dev/null
+++ b/python/sglang/kernels/jit/csrc/elementwise/route_activation.cuh
@@ -0,0 +1,83 @@
+#include "elementwise/activation.cuh"
+
+namespace sglang {
+struct RouteActivationParams {
+  const void* input;
+  void* output;
+  const void* scales;
+  const int32_t* ids;
+  uint32_t rows;
+  uint32_t experts;
+};
+
+// Match the scored Triton BF16 scaling boundary even with fast-math activation.
+SGL_DEVICE float route_scale_product(float value, float scale) {
+  float result;
+  asm("mul.rn.f32 %0, %1, %2;" : "=f"(result) : "f"(value), "f"(scale));
+  return result;
+}
+
+template <typename T, bool kUsePDL, uint32_t kGroup>
+__global__ void route_scaled_activation(const __grid_constant__ RouteActivationParams p) {
+  using namespace device;
+  constexpr uint32_t kValues = kMaxVecBytes / sizeof(T);
+  constexpr uint32_t kVectors = 4096 / kValues;
+  constexpr uint32_t kThreads = 256;
+  using vec_t = AlignedVector<T, kValues>;
+  const uint32_t base_row = blockIdx.x * kGroup;
+  const uint32_t lane = threadIdx.x % 32;
+  PDLWaitPrimary<kUsePDL>();
+  const int expert = lane < kGroup && base_row + lane < p.rows ? p.ids[base_row + lane] : -1;
+  uint32_t active = __ballot_sync(0xffffffffu, expert >= 0 && uint32_t(expert) < p.experts);
+  // Each warp visits the same live rows. No CTA synchronization or CPU count read.
+  while (active) {
+    const int slot = __ffs(active) - 1;
+    const int selected = __shfl_sync(0xffffffffu, expert, slot);
+    const float scale = device::cast<fp32_t>(static_cast<const T*>(p.scales)[selected]);
+    const uint32_t row = base_row + slot;
+#pragma unroll
+    for (uint32_t vector = threadIdx.x; vector < kVectors; vector += kThreads) {
+      const uint32_t offset = row * (2 * kVectors) + vector;
+      const vec_t gate = device::load_as<vec_t>(p.input, offset);
+      const vec_t up = device::load_as<vec_t>(p.input, offset + kVectors);
+      vec_t result;
+#pragma unroll
+      for (uint32_t i=0; i<kValues; ++i) {
+        const T rounded_gate = device::cast<T>(route_scale_product(device::cast<fp32_t>(gate[i]), scale));
+        const T rounded_up = device::cast<T>(route_scale_product(device::cast<fp32_t>(up[i]), scale));
+        const float activation = apply_activation_f32<ActivationKind::kSiLU>(device::cast<fp32_t>(rounded_gate));
+        result[i] = device::cast<T>(activation * device::cast<fp32_t>(rounded_up));
+      }
+      device::store_as<vec_t>(p.output, result, row * kVectors + vector);
+    }
+    active &= active - 1;
+  }
+  PDLTriggerSecondary<kUsePDL>();
+}
+
+template <typename T, bool kUsePDL, uint32_t kGroup>
+struct RouteActivationKernel {
+  static void run(tvm::ffi::TensorView input, tvm::ffi::TensorView output,
+                  tvm::ffi::TensorView ids, tvm::ffi::TensorView scales) {
+    using namespace host;
+    static_assert(kGroup > 0 && kGroup <= 32);
+    auto rows = SymbolicSize{"rows"};
+    auto experts = SymbolicSize{"experts"};
+    auto device_ = SymbolicDevice{};
+    device_.set_options<kDLCUDA>();
+    TensorMatcher({rows, 8192}).with_dtype<T>().with_device(device_).verify(input);
+    TensorMatcher({rows, 4096}).with_dtype<T>().with_device(device_).verify(output);
+    TensorMatcher({rows}).with_dtype<int32_t>().with_device(device_).verify(ids);
+    TensorMatcher({experts}).with_dtype<T>().with_device(device_).verify(scales);
+    constexpr uint32_t kVectors = 4096 / (device::kMaxVecBytes / sizeof(T));
+    RuntimeCheck(rows.unwrap() <= std::numeric_limits<uint32_t>::max() / (2 * kVectors), "row offsets overflow");
+    RuntimeCheck(experts.unwrap() > 0, "invalid expert count");
+    if (rows.unwrap() == 0) return;
+    const RouteActivationParams params{input.data_ptr(), output.data_ptr(), scales.data_ptr(),
+      static_cast<const int32_t*>(ids.data_ptr()), static_cast<uint32_t>(rows.unwrap()),
+      static_cast<uint32_t>(experts.unwrap())};
+    LaunchKernel(div_ceil(params.rows, kGroup), 256u, device_.unwrap())
+      .enable_pdl(kUsePDL)(route_scaled_activation<T, kUsePDL, kGroup>, params);
+  }
+};
+}  // namespace sglang
diff --git a/python/sglang/kernels/ops/moe/muse_spark_grouped_routes.py b/python/sglang/kernels/ops/moe/muse_spark_grouped_routes.py
new file mode 100644
index 0000000..a76d657
--- /dev/null
+++ b/python/sglang/kernels/ops/moe/muse_spark_grouped_routes.py
@@ -0,0 +1,243 @@
+"""Stable suffix-anchored per-expert grouped Humming, with device-only route maps."""
+import torch
+import triton
+import triton.language as tl
+from humming.layer import HummingMethod
+
+
+@triton.jit
+def _local_ids(ids, partial, ranks, ROUTES:tl.constexpr, BLOCK:tl.constexpr):
+    expert = tl.program_id(0)
+    chunk = tl.program_id(1)
+    pos = chunk * BLOCK + tl.arange(0, BLOCK)
+    key = tl.load(ids+pos, pos<ROUTES, other=-1)
+    hit = key == expert
+    rank = tl.cumsum(hit.to(tl.int32), 0) - 1
+    tl.store(ranks+pos, rank, hit)
+    tl.store(partial+chunk*32+expert, tl.sum(hit.to(tl.int32),0))
+
+
+@triton.jit
+def _offsets(prefix, offsets, base, CHUNKS:tl.constexpr, LIGHT:tl.constexpr, HEAVY:tl.constexpr, CUTOFF:tl.constexpr):
+    experts = tl.arange(0,32)
+    counts = tl.load(prefix+(CHUNKS-1)*32+experts)
+    light = counts <= CUTOFF
+    nl = tl.where(light, counts, 0)
+    nh = tl.where(light, 0, counts)
+    a = LIGHT - tl.sum(nl,0) + tl.cumsum(nl,0) - nl
+    b = HEAVY - tl.sum(nh,0) + tl.cumsum(nh,0) - nh
+    tl.store(offsets+experts,a)
+    tl.store(offsets+32,LIGHT)
+    tl.store(offsets+33+experts,b)
+    tl.store(offsets+65,HEAVY)
+    tl.store(base+experts,tl.where(light,a,LIGHT+b))
+
+
+@triton.jit
+def _complete(ids, ranks, prefix, base, ROUTES:tl.constexpr, BLOCK:tl.constexpr):
+    ch = tl.program_id(0)
+    pos = ch*BLOCK+tl.arange(0,BLOCK)
+    e = tl.load(ids+pos,pos<ROUTES,other=-1)
+    live=e>=0
+    rank=tl.load(ranks+pos,live,other=0)
+    counts=tl.load(prefix+(ch-1)*32+e,live & (ch>0),other=0)
+    offset=tl.load(base+e,live,other=0)
+    tl.store(ranks+pos,tl.where(live,rank+counts+offset,-1),pos<ROUTES)
+
+
+@triton.jit
+def _copy(x,y,ranks,H:tl.constexpr,PACK:tl.constexpr,TILE:tl.constexpr):
+    route=tl.program_id(0)
+    placed=tl.load(ranks+route)
+    if placed>=0:
+        j=tl.program_id(1)*TILE+tl.arange(0,TILE)
+        if PACK:
+            tl.store(y+placed*H+j,tl.load(x+(route//8)*H+j))
+        else:
+            tl.store(y+route*H+j,tl.load(x+placed*H+j))
+
+
+@triton.jit
+def _activation(x,y,ids,ranks,scales,H:tl.constexpr,TILE:tl.constexpr):
+    route=tl.program_id(0)
+    pos=tl.load(ranks+route)
+    if pos>=0:
+        j=tl.program_id(1)*TILE+tl.arange(0,TILE)
+        e=tl.load(ids+route)
+        scale=tl.load(scales+e).to(tl.float32)
+        gate=(tl.load(x+pos*(2*H)+j).to(tl.float32)*scale).to(tl.bfloat16).to(tl.float32)
+        up=(tl.load(x+pos*(2*H)+H+j).to(tl.float32)*scale).to(tl.bfloat16).to(tl.float32)
+        exp=tl.inline_asm_elementwise("ex2.approx.ftz.f32 $0, $1;",constraints="=f,f",args=[-gate*1.4426950408889634],dtype=tl.float32,is_pure=True,pack=1)
+        value=tl.inline_asm_elementwise("div.approx.ftz.f32 $0, $1, $2;",constraints="=f,f,f",args=[gate,1.+exp],dtype=tl.float32,is_pure=True,pack=1)
+        tl.store(y+pos*H+j,value*up)
+
+
+def mapping(ids,cutoff):
+    m=ids.size(0)
+    device=ids.device
+    slots=m*8
+    light=min(slots,32*max(cutoff,0))
+    chunks=triton.cdiv(slots,256)
+    ranks=torch.empty(slots,device=device,dtype=torch.int32)
+    partial=torch.empty((chunks,32),device=device,dtype=torch.int32)
+    offsets=torch.empty(66,device=device,dtype=torch.int32)
+    base=torch.empty(32,device=device,dtype=torch.int32)
+    _local_ids[32,chunks](ids,partial,ranks,slots,256)
+    prefix=torch.cumsum(partial,dim=0,dtype=torch.int32) if chunks>1 else partial
+    _offsets[(1,)](prefix,offsets,base,chunks,light,slots,cutoff)
+    _complete[(chunks,)](ids,ranks,prefix,base,slots,256)
+    return ranks,offsets,light
+
+
+def compute(layer,x,ids,split,variant,scores,norm,global_experts):
+    m,h=x.shape
+    slots=m*8
+    assert ids.shape==(m,8) and h==4096
+    plan=split._choose_large_prefill_configs(layer,slots,global_experts)
+    if plan is None:
+        fixed={s:next(c for lo,hi,c in table if lo<slots<=hi) for s,table in layer.fp32_configs.items()}
+        plan=dict(light=fixed,heavy=fixed,cutoff=-1)
+    cutoff=plan["cutoff"] if variant=="split_fused" else -1
+    ranks,offsets,light=mapping(ids,cutoff)
+    rows=light+slots
+    concat=x.new_empty((rows,2*h))
+    up=concat
+    down=concat.view(-1)[:rows*h].view(rows,h)
+    inputs=x.new_empty((rows,h))
+    # The gathered input can be reused for activation after all W13 reads complete.
+    _copy[(slots,4)](x,inputs,ranks,h,True,1024)
+    for stage,inp,out in (("w13",inputs,up),("w2",inputs,down)):
+        if stage=="w2":
+            _activation[(slots,4)](up,inputs,ids,ranks,layer.w13_post_scale,h,1024)
+        parts=[]
+        if light:
+            parts.append((0,light,offsets[:33],plan["light"][stage]))
+        cfg=plan["light" if variant=="single_light" else "heavy"][stage]
+        parts.append((light,rows,offsets[33:],cfg))
+        for lo,hi,layout,cfg in parts:
+            HummingMethod.forward_layer(layer,inputs=inp[lo:hi],outputs=out[lo:hi],top_k=1,
+                sublayer_name=stage,tuning_config=cfg,expert_layout=layout,valid_shape_m=hi-lo,
+                compute_config={"gemm_type":"grouped_contiguous","use_f16_accum":False})
+    normalized=x.new_empty((m,h))
+    _mapped_finalize[(m,)](down,norm,scores,normalized,ids,ranks,layer.w2_post_scale,
+        HAS_SCALE=True,TOPK=8,H=h,eps=1e-8,APPLY_NORM=True,HAS_WEIGHT=True,WEIGHT_FIRST=True,
+        HAS_IDS=True,ROUND_PRODUCT=False,BLOCK_H=h,num_warps=8,num_stages=2)
+    return normalized
+@triton.jit
+def _mapped_finalize(
+    x_ptr,
+    w_ptr,
+    s_ptr,
+    out_ptr,
+    ids_ptr,
+    ranks_ptr,
+    scale_ptr,
+    HAS_SCALE: tl.constexpr,
+    TOPK: tl.constexpr,
+    H: tl.constexpr,
+    eps,
+    APPLY_NORM: tl.constexpr,
+    HAS_WEIGHT: tl.constexpr,
+    WEIGHT_FIRST: tl.constexpr,
+    HAS_IDS: tl.constexpr,
+    ROUND_PRODUCT: tl.constexpr,
+    BLOCK_H: tl.constexpr,
+):
+    tok = tl.program_id(0)
+    offs = tl.arange(0, BLOCK_H)
+    mask = offs < H
+
+    if HAS_WEIGHT:
+        w = tl.load(w_ptr + offs, mask=mask, other=0.0).to(tl.float32)
+
+    acc = tl.zeros([BLOCK_H], dtype=tl.float32)
+
+    for k in tl.static_range(TOPK):
+        base = tl.load(ranks_ptr + tok * TOPK + k) * H
+        live = True
+        expert_id = -1
+        if HAS_IDS:
+            expert_id = tl.load(ids_ptr + tok * TOPK + k)
+            live = expert_id >= 0
+        if live:
+            x = tl.load(x_ptr + base + offs, mask=mask, other=0.0).to(tl.float32)
+            if HAS_SCALE:
+                scale = tl.load(scale_ptr + expert_id).to(tl.float32)
+                # Preserve BF16 multiplication before FP32 norm/reduction.
+                x = (x * scale).to(tl.bfloat16).to(tl.float32)
+
+            if APPLY_NORM:
+                if HAS_WEIGHT and WEIGHT_FIRST:
+                    y = x * w
+                    var = tl.sum(y * y, axis=0) / H
+                    y = y * tl.rsqrt(var + eps)
+                elif HAS_WEIGHT:
+                    var = tl.sum(x * x, axis=0) / H
+                    y = x * tl.rsqrt(var + eps) * w
+                else:
+                    var = tl.sum(x * x, axis=0) / H
+                    y = x * tl.rsqrt(var + eps)
+            else:
+                y = x
+
+            s = tl.load(s_ptr + tok * TOPK + k).to(tl.float32)
+            product = y * s
+            if ROUND_PRODUCT:
+                product = product.to(x_ptr.dtype.element_ty).to(tl.float32)
+            acc += product
+
+    tl.store(out_ptr + tok * H + offs, acc.to(out_ptr.dtype.element_ty), mask=mask)
+
+PROVEN_GEOMETRY = frozenset([
+    ((8, 6), 'w13', (16, 256, 128), (16, 64, 64), 3),
+    ((8, 6), 'w13', (32, 256, 64), (16, 64, 64), 3),
+    ((8, 6), 'w13', (48, 256, 128), (48, 64, 64), 3),
+    ((8, 6), 'w13', (128, 256, 64), (64, 64, 64), 3),
+    ((8, 6), 'w2', (16, 256, 128), (16, 64, 64), 3),
+    ((8, 6), 'w2', (32, 256, 64), (16, 64, 64), 3),
+    ((8, 6), 'w2', (48, 256, 128), (48, 64, 64), 3),
+    ((8, 6), 'w2', (128, 256, 64), (64, 64, 64), 3),
+    ((9, 0), 'w13', (16, 256, 128), (16, 32, 64), 4),
+    ((9, 0), 'w13', (48, 256, 64), (48, 32, 64), 4),
+    ((9, 0), 'w13', (64, 256, 64), (64, 32, 64), 4),
+    ((9, 0), 'w2', (16, 128, 256), (16, 32, 64), 4),
+    ((9, 0), 'w2', (48, 128, 64), (48, 32, 64), 4),
+    ((9, 0), 'w2', (64, 128, 128), (64, 32, 64), 4),
+])
+
+def try_grouped(owner,x,topk_ids,scores):
+    """Return the grouped output for a qualified graph shape, otherwise defer."""
+    from sglang.kernels.ops.moe import muse_spark_humming_split as split
+    if (x.device.type!="cuda" or x.dtype!=torch.bfloat16 or x.ndim!=2 or
+        x.shape[1]!=4096 or owner.global_num_experts<32 or owner.global_num_experts%32 or
+        topk_ids.shape!=(x.shape[0],8) or scores.shape!=topk_ids.shape or
+        scores.dtype!=torch.float32 or scores.device!=x.device or topk_ids.device!=x.device or
+        topk_ids.dtype not in (torch.int32,torch.int64) or
+        not owner._post_expert_norm_weight_first or owner._post_expert_norm_eps!=1e-8):
+        return None
+    norm=owner._post_expert_norm_weight
+    if norm is None or norm.shape!=(4096,) or norm.device!=x.device or norm.dtype not in (torch.bfloat16,torch.float32):
+        return None
+    layer=owner._humming_layer
+    if owner._expert_map is None or layer.w13_post_scale.numel()!=32 or layer.w2_post_scale.numel()!=32:
+        return None
+    sm=torch.cuda.get_device_capability(x.device)
+    if sm not in ((8,6),(9,0)):
+        return None
+    from sglang.kernels.ops.moe.muse_spark_route_policy import route_regime
+    plan=split._choose_large_prefill_configs(layer,topk_ids.numel(),owner.global_num_experts)
+    if route_regime(topk_ids.numel(),32,owner.global_num_experts,plan) != "grouped":
+        return None
+    for kind in ("light","heavy"):
+        for stage in ("w13","w2"):
+            cfg=plan[kind][stage]
+            if (set(cfg)-{"block_shape","warp_shape","num_stages","use_f16_accum","use_stream_k","num_sms","num_ctas_per_sm","num_write_splits"} or
+                    cfg.get("num_ctas_per_sm",1)!=1 or cfg.get("num_write_splits",1)!=1 or
+                    cfg.get("use_f16_accum") is not False or cfg.get("use_stream_k") is not False):
+                return None
+            key=(sm,stage,tuple(cfg["block_shape"]),tuple(cfg["warp_shape"]),cfg["num_stages"])
+            if key not in PROVEN_GEOMETRY:
+                return None
+    local=topk_ids.to(torch.int32)
+    local=owner._expert_lookup[local.clamp_min(-1)+1].contiguous()
+    return compute(layer,x.contiguous(),local,split,"split_fused",scores.contiguous(),norm.contiguous(),owner.global_num_experts)
