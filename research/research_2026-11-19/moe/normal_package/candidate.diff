+                for key in ("block_shape", "warp_shape"):
+                    shape = config.get(key)
+                    if (not isinstance(shape, (list, tuple)) or len(shape) != 3
+                            or any(type(v) is not int or v <= 0 for v in shape)):
+                        return None
