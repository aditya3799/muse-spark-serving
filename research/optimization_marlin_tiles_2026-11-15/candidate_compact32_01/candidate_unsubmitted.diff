+def _post_expert_inv_rms_kernel(
+    x_ptr,
+    w_ptr,
+    ids_ptr,
+    inv_ptr,
+    TOPK: tl.constexpr,
+    H: tl.constexpr,
+    eps,
+    HAS_WEIGHT: tl.constexpr,
+    WEIGHT_FIRST: tl.constexpr,
+    BLOCK_H: tl.constexpr,
+):
+    slot = tl.program_id(0)
