+def nccl_row_projection_supported(group, partial, weight) -> bool:
+    """Keep the native FP32 custom-reduction regime unchanged.
+
+    Only consider tensors above the communicator's actual custom-AR capacity,
+    and exclude every other specialized all-reduce backend. The baseline then
+    uses NCCL with the same BF16 input/output dtype as this reduce-scatter.
+    """
+    from sglang.srt.distributed.device_communicators.custom_all_reduce_v2 import (
+        CustomAllReduceV2,
+    )
+
+    if not prefill_row_projection_supported(group, partial, weight):
+        return False
+    comm = group.ca_comm
+    if not isinstance(comm, CustomAllReduceV2):
+        return False
+    if partial.numel() * partial.element_size() <= comm.max_size:
+        return False
+    if group.pynccl_comm is None or group._fi_workspace_hint is not None:
+        return False
+    for name in (
+        "pcie_ipc_comm", "qr_comm", "pymscclpp_comm", "torch_symm_mem_comm"
+    ):
+        other = getattr(group, name, None)
+        if other is not None and not getattr(other, "disabled", False):
+            return False
+    return True
+
+
+def reduce_scatter_row_projection(group, partial, weight):
+    """Reduce expert row shards before their complete-K replicated projection.
+
+    Caller requires equal contiguous token-row partitions, independent expert
+    contributions and no preceding fused reduction. BF16 collective dtype and
+    FP32 GEMM output preserve the existing arithmetic precision boundaries.
+    """
+    local_input = group.reduce_scatter_along_dim(partial, dim=0)
+    local_fp32 = torch.mm(local_input, weight.t(), out_dtype=torch.float32)
+    local = local_fp32.to(partial.dtype)
+    del local_fp32
+    return group.all_gather(local, dim=0)
+
