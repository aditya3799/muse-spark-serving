+"""Per-forward FA3 native-window scheduler sharing.
+
+Only the scheduler plan is shared. Q/K/V, masks, arithmetic, split policy and
+attention calls remain unchanged. Each eager forward and graph recording gets
+fresh state; a graph replay reruns its recorded scheduler operation.
+"""
+import inspect
+
+
+def supports_swa_scheduler_reuse(factory):
+    if factory is None:
+        return False
+    required = {
+        "batch_size", "max_seqlen_q", "max_seqlen_k", "num_heads", "num_heads_k",
+        "headdim", "headdim_v", "cache_seqlens", "qkv_dtype", "cu_seqlens_q",
+        "cu_seqlens_k_new", "page_size", "max_seqlen_k_new", "causal",
+        "window_size", "has_softcap", "num_splits", "pack_gqa", "sm_margin",
+    }
+    try:
+        return required <= set(inspect.signature(factory).parameters)
+    except (TypeError, ValueError):
+        return False
+
+
+def reset_swa_scheduler_cache(backend, forward_batch, *, allow):
+    # Called again INSIDE every model warmup/capture, so warmup plans and plans
+    # from another graph never suppress the operation in a new recording.
+    backend._swa_verify_scheduler_cache = (
+        {} if allow and not backend._swa_scheduler_reuse_disabled
+        and forward_batch.forward_mode.is_target_verify() else None
+    )
+
+
+def get_swa_verify_scheduler_metadata(
+    backend, forward_batch, metadata, layer, q, key_cache, value_cache,
+    page_table, cache_seqlens, cu_seqlens_q, cu_seqlens_k_new, max_seqlen_q,
+    window_size, *, causal, cp_active, use_local_attn, use_cascade_attn,
+    sinks, score_mod, rel_bias,
+):
+    cache = getattr(backend, "_swa_verify_scheduler_cache", None)
+    if cache is None or not forward_batch.forward_mode.is_target_verify():
+        return None
+    if (
+        backend.fa_impl_ver != 3 or backend.use_mla or backend.topk > 1
+        or backend._disable_scheduler_metadata_precompute
+        or backend.local_attn_builder is not None or backend._kv_shard_pool is not None
+        or backend.is_prefill_aware_swa or cp_active or use_local_attn or use_cascade_attn
+        or layer.is_cross_attention or not causal or window_size[0] < 0
+        or window_size[1] != 0 or sinks is not None or score_mod is not None
+        or rel_bias is not None or metadata.image_token_ranges is not None
+        or metadata.swa_spec_metadata is not None
+        or q.dtype != key_cache.dtype or q.dtype != value_cache.dtype
+        or key_cache.shape[1] != backend.page_size
+        or page_table.shape[0] != forward_batch.batch_size
+        or cache_seqlens.shape[0] != forward_batch.batch_size
+        or cu_seqlens_q.shape[0] != forward_batch.batch_size + 1
+        # Native planner lacks total_q; fwd split heuristic uses q.size(0).
+        # Fixed-width verify is equivalent to its batch*max_q fallback.
+        or q.shape[0] != forward_batch.batch_size * max_seqlen_q
+        or layer.tp_q_head_num != backend.num_attention_heads
+        or layer.tp_k_head_num != backend.num_kv_heads
+        or layer.head_dim != backend.head_dim or layer.v_head_dim != backend.head_dim
+        or bool(layer.logit_cap > 0) != backend.has_softcap
+        or cache_seqlens is not metadata.cache_seqlens_int32
+        or cu_seqlens_q is not metadata.cu_seqlens_q
+        or cu_seqlens_k_new is not metadata.cu_seqlens_k
+        or (page_table is not metadata.page_table and page_table is not metadata.swa_page_table)
+    ):
+        return None
+    # Identities distinguish simultaneous per-forward views, never cache length
+    # contents across forwards. These tensors are retained by the live metadata.
+    key = (
+        forward_batch.batch_size, max_seqlen_q, page_table.shape[1], backend.page_size,
+        layer.tp_q_head_num, layer.tp_k_head_num, layer.head_dim, layer.v_head_dim,
+        q.dtype, q.device, tuple(window_size), causal, layer.logit_cap > 0,
+        backend.num_splits, id(page_table), id(cache_seqlens), id(cu_seqlens_q),
+        id(cu_seqlens_k_new),
+    )
+    if key not in cache:
+        cache[key] = backend._get_scheduler_metadata(
+            batch_size=forward_batch.batch_size, max_seqlen_q=max_seqlen_q,
+            max_seqlen_k=page_table.shape[1] * backend.page_size,
+            num_heads=layer.tp_q_head_num, num_heads_k=layer.tp_k_head_num,
+            headdim=layer.head_dim, headdim_v=layer.v_head_dim,
+            cache_seqlens=cache_seqlens, qkv_dtype=q.dtype,
+            # The attention call has k=None/v=None; native fwd ignores its
+            # cu_seqlens_k_new in that case. Match the effective no-append plan.
+            cu_seqlens_q=cu_seqlens_q, cu_seqlens_k_new=None,
+            page_size=backend.page_size, max_seqlen_k_new=0,
+            causal=causal, window_size=window_size, has_softcap=layer.logit_cap > 0,
+            num_splits=backend.num_splits, pack_gqa=None, sm_margin=0,
+        )
+    return cache[key]
