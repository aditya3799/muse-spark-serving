+            light["warp_shape"] = list(light["warp_shape"])
+            light["block_shape"][2] = heavy["block_shape"][2]
+            light["warp_shape"][2] = heavy["warp_shape"][2]
+            if light["block_shape"][0] > heavy["block_shape"][0]:
+                return None
+            for config in (light, heavy):
