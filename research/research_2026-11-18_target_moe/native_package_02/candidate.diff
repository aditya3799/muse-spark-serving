+struct Smem {
+  uint64_t bars[24];
+  int wcp[JMAX + 1], wcpB[JMAX + 1], jrow[JMAX + 1];
+  uint32_t wtot, wtotB;
+  int wgr[4], wc[NW][32];
+  int jE[JMAX], jS[JMAX], jC[JMAX], njF, njS, gen;
