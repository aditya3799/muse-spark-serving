+        # Immutable capture-time fingerprint detects even in-place storage/view
+        # mutation of the canonical Tensor, not only replacement of its object.
+        if (spec != (self.hidden_size, self.capture_ids)
+            or not self.owns(buffer) or tuple(buffer.shape) != self._binding[1]):
+            raise RuntimeError("decode auxiliary binding changed; rebuild captured runner")
