+    def owns(self, output):
+        if not torch.is_tensor(output) or output.ndim != 2:
+            return False
+        pointer, shape, stride, dtype, device = self._binding
+        return (
+            output.data_ptr() == pointer
+            and 0 < output.shape[0] <= shape[0]
+            and output.shape[1] == shape[1]
+            and output.stride() == stride
+            and output.dtype == dtype
+            and output.device == device
+        )
