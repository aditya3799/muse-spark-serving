+        start = self.index * self.hidden_size
+        if not already_written:
+            self.buffer[:, start : start + self.hidden_size].copy_(residual)
+        self.index += 1
+
+    def finalize(self):
+        if self.index != len(self.capture_ids):
+            raise RuntimeError("incomplete auxiliary capture")
+        return self.buffer
+
